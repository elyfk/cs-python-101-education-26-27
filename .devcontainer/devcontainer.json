{
  "name": "METU IEEE CS Python Environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "onCreateCommand": "pip install --no-cache-dir ipykernel numpy matplotlib opencv-python-headless && python -m ipykernel install --user --name python3 --display-name 'Python 3'",
  "postCreateCommand": "echo 'echo \"Welcome to the CS Python 101 Environment!\"' >> ~/.bashrc",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.kernels.trusted": [
          "/usr/local/bin/python"
        ],
        "notebook.lineNumbers": "on",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true
        },
        "black-formatter.args": [
          "--line-length",
          "88"
        ]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-toolsai.jupyter"
      ]
    }
  }
}